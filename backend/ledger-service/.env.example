# Copy to .env and fill in real values. Never commit the real .env file.
# For local `mvn spring-boot:run`, load this with: set -a; source .env; set +a

# Database (same Postgres instance as the monolith, schema "ledger")
DB_URL=jdbc:postgresql://localhost:5432/gprflow?currentSchema=ledger
DB_USERNAME=postgres
DB_PASSWORD=postgres

# No JWT_SECRET here: ledger-service never parses a JWT itself. It trusts the
# X-User-Id/X-User-Role/X-User-Email/X-User-Full-Name headers set by the gateway,
# which is the only component that validates the token (Fase 6).

# Frontend base URL for payment callbacks
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_API_KEY=your key

# Razorpay
RAZORPAY_API_KEY=your razorpay key
RAZORPAY_API_SECRET=your razorpay secret

# coin-service base URL, used to enrich order/asset responses with live coin data
COIN_SERVICE_URL=http://coin-service:5455
