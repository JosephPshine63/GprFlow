# Copy to .env and fill in real values. Never commit the real .env file.
# For local `mvn spring-boot:run`, load this with: set -a; source .env; set +a

# Database
DB_URL=jdbc:postgresql://localhost:5432/gprflow?currentSchema=auth
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT — must match the gateway's JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Resend (https://resend.com) — from must be on a domain verified in the Resend dashboard
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="GprFlow <noreply@gprflow.trade>"

# user-service base URL — Docker Compose DNS default, override for local/non-Docker dev
USER_SERVICE_URL=http://localhost:5459

# Seed admin account, created on first startup if no user with this email exists yet
ADMIN_EMAIL=admin@gprflow.trade
ADMIN_PASSWORD=change-me-before-first-boot
ADMIN_FULL_NAME=GprFlow Admin
