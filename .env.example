# Copy to .env and fill in real values. Never commit the real .env file.
# Read automatically by `docker compose` when present in this directory.

# Database
DB_NAME=gprflow
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Frontend URL used for payment redirect callbacks (seen by the app container)
FRONTEND_URL=http://localhost:5173

# Base URL the browser uses to reach the backend, i.e. the gateway (baked
# into the frontend container's runtime-config.js at startup)
API_BASE_URL=http://localhost:8087

# true shows the Stripe test card hint on the top-up form (use with sk_test_ keys only)
STRIPE_TEST_MODE=false

# Cloudflare Turnstile on signup/signin/password reset. These are Cloudflare's always-pass
# test keys: the flow works but nothing is actually blocked. Swap in real keys from the
# Cloudflare dashboard to enforce it; TURNSTILE_ENABLED=false turns the check off.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=true

# Resend (https://resend.com) — from must be on a domain verified in the Resend dashboard
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="GprFlow <noreply@gprflow.trade>"

# Stripe
STRIPE_API_KEY=sk_test_xxx

# CoinGecko
COINGECKO_API_KEY=your-coingecko-api-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Seed admin account, created on first startup if no user with this email exists yet
ADMIN_EMAIL=admin@gprflow.trade
ADMIN_PASSWORD=change-me-before-first-boot
ADMIN_FULL_NAME=GprFlow Admin

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Configure).
# Only needed in production, where the cloudflared service exposes app/api.gprflow.trade.
TUNNEL_TOKEN=your-cloudflare-tunnel-token
