# Env — never commit real secrets, only the .env.example templates
.env
.env.*.local
*.env
!.env.example
!**/.env.example

# Build output (each backend module also has its own copy of this for
# `mvn -f backend/<service>` runs directly in that directory)
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Frontend
node_modules/
dist/
dist-ssr/

# Logs
*.log
logs/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
