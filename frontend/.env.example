# Copy to .env and fill in real values. Never commit the real .env file.
# Vite only exposes variables prefixed with VITE_ to client code.

# Gateway published by `docker compose up` (host 8087). Use http://localhost:8080 if you
# run backend/gateway directly with `mvn spring-boot:run`.
VITE_API_BASE_URL=http://localhost:8087

# true shows the Stripe test card hint on the top-up form
VITE_STRIPE_TEST_MODE=false

# Cloudflare Turnstile site key; unset falls back to the always-pass test key
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# DeepL key for `npm run i18n:translate` (dev only, never used by the app or CI).
# Keys ending in :fx use the free API endpoint.
# DEEPL_API_KEY=
